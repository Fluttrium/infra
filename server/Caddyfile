# Reverse-proxy с авто-HTTPS (Let's Encrypt). Ставится на сервер перед сервисами.
# Caddy сам получит и продлит сертификаты — нужны лишь DNS-записи на сервер и порты 80/443.

# Приватный реестр пакетов
npm.fluttrium.store {
    reverse_proxy localhost:4873
}

# Vendure API (pool-инстанс)
api.fluttrium.store {
    reverse_proxy localhost:3000
}

# Админка (тот же Vendure-сервер; Dashboard на /dashboard, admin-api — там же → без CORS)
admin.fluttrium.store {
    reverse_proxy localhost:3000
}

# Витрины демо-магазинов (если решишь хостить у себя; иначе — на стороне клиента)
# fabric.fluttrium.store {
#     reverse_proxy localhost:3001
# }

# Демо-витрина магазина «Kava»
demo.fluttrium.store {
    reverse_proxy localhost:3001
}

# Маркетинговый сайт маркета (репозиторий market-website, /home/deploy/website).
# Контейнер слушает только 127.0.0.1:3002 — наружу ходит Caddy, он же держит TLS.
promo.fluttrium.store {
    reverse_proxy localhost:3002
}

# Документация продавцов и разработчиков (репозиторий Fluttrium/docs, ~/docs).
# Статика в nginx на 127.0.0.1:3004, Caddy держит домен и TLS.
docs.fluttrium.store {
    encode zstd gzip
    reverse_proxy localhost:3004
}

# Бухгалтерия (форк Midday). Один домен, три сервиса за путями:
#   /api-v1/*   → API приложения (tRPC)
#   /supabase/* → Supabase (вход, файлы)
#   всё прочее  → интерфейс
buh.fluttrium.com {
    handle_path /api-v1/* {
        reverse_proxy localhost:3013
    }

    handle_path /supabase/* {
        reverse_proxy localhost:8000
    }

    handle {
        reverse_proxy localhost:3010
    }
}
